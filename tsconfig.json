{
  // Repository-level Bun scripts outside the workspaces (tools/release/*.ts).
  // Each workspace has its own tsconfig; this one gives the IDE and `bun run typecheck` Bun's types here.
  "compilerOptions": {
    "target": "ES2023",
    "lib": ["ES2023"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "noEmit": true,
    "isolatedModules": true,
    "verbatimModuleSyntax": true,
    "allowImportingTsExtensions": true,
    "skipLibCheck": true,
    "types": ["bun"]
  },
  "include": ["tools/release/*.ts"]
}
