{
  "resourceType": "Measure",
  "id": "anc-first-visit-next-visit-booked",
  "url": "https://health.go.ug/fhir/Measure/anc-first-visit-next-visit-booked",
  "version": "1.0.0",
  "name": "AncFirstVisitNextVisitBooked",
  "title": "ANC 1st visits with the next visit booked",
  "status": "active",
  "description": "Of the women in ANC 1st visits for the period, the percentage whose next booked visit is within 4 weeks after the period's end.",
  "extension": [
    {
      "url": "https://carapai.github.io/people-centered-healthcare/fhir/StructureDefinition/indicator-period-date",
      "valueExpression": {
        "language": "text/fhirpath",
        "expression": "Encounter.actualPeriod.start",
        "description": "When the visit started"
      }
    },
    {
      "url": "https://carapai.github.io/people-centered-healthcare/fhir/StructureDefinition/indicator-counts",
      "valueCode": "people"
    }
  ],
  "scoring": {
    "coding": [
      {
        "system": "http://terminology.hl7.org/CodeSystem/measure-scoring",
        "code": "proportion"
      }
    ]
  },
  "basis": "Encounter",
  "group": [
    {
      "population": [
        {
          "id": "initial-population",
          "code": {
            "coding": [
              {
                "system": "http://terminology.hl7.org/CodeSystem/measure-population",
                "code": "initial-population"
              }
            ]
          },
          "description": "Everyone with care in the period",
          "criteria": {
            "language": "text/fhirpath",
            "expression": "true"
          }
        },
        {
          "id": "denominator",
          "code": {
            "coding": [
              {
                "system": "http://terminology.hl7.org/CodeSystem/measure-population",
                "code": "denominator"
              }
            ]
          },
          "description": "Is in ANC 1st visits' numerator",
          "criteria": {
            "language": "text/fhirpath",
            "expression": "'https://health.go.ug/fhir/Measure/anc-first-visits|1.0.0' in %indicators.numerator"
          }
        },
        {
          "id": "numerator",
          "code": {
            "coding": [
              {
                "system": "http://terminology.hl7.org/CodeSystem/measure-population",
                "code": "numerator"
              }
            ]
          },
          "description": "Next appointment is within 4 weeks after the period end",
          "criteria": {
            "language": "text/fhirpath",
            "expression": "(%records.entry.resource.ofType(Appointment).where(status = 'booked').start.first().toDate() > %periodEnd.toDate() and %records.entry.resource.ofType(Appointment).where(status = 'booked').start.first().toDate() <= %periodEnd.toDate() + 4 weeks)"
          }
        }
      ]
    }
  ]
}
