{
  "resourceType": "Measure",
  "id": "anc-first-visit-before-12-weeks",
  "url": "https://health.go.ug/fhir/Measure/anc-first-visit-before-12-weeks",
  "version": "1.0.0",
  "name": "AncFirstVisitBefore12Weeks",
  "title": "ANC 1st visit before 12 weeks",
  "status": "active",
  "description": "Of the women whose first antenatal care visit was in the period, the percentage whose gestational age at that visit was under 12 weeks (HMIS 105, ANC 1st visit within 12 weeks).",
  "extension": [
    {
      "url": "https://carapai.github.io/people-centered-healthcare/fhir/StructureDefinition/indicator-period-date",
      "valueExpression": {
        "language": "text/fhirpath",
        "expression": "Encounter.actualPeriod.start",
        "description": "When the visit started"
      }
    },
    {
      "url": "https://carapai.github.io/people-centered-healthcare/fhir/StructureDefinition/indicator-counts",
      "valueCode": "people"
    }
  ],
  "scoring": {
    "coding": [
      {
        "system": "http://terminology.hl7.org/CodeSystem/measure-scoring",
        "code": "proportion"
      }
    ]
  },
  "basis": "Encounter",
  "group": [
    {
      "population": [
        {
          "id": "initial-population",
          "code": {
            "coding": [
              {
                "system": "http://terminology.hl7.org/CodeSystem/measure-population",
                "code": "initial-population"
              }
            ]
          },
          "description": "Everyone with care in the period",
          "criteria": {
            "language": "text/fhirpath",
            "expression": "true"
          }
        },
        {
          "id": "denominator",
          "code": {
            "coding": [
              {
                "system": "http://terminology.hl7.org/CodeSystem/measure-population",
                "code": "denominator"
              }
            ]
          },
          "description": "A first ANC visit by a woman",
          "criteria": {
            "language": "text/fhirpath",
            "expression": "Encounter.type.coding.where(system = 'https://health.go.ug/fhir/CodeSystem/anc-visit-type' and code = 'first').exists() and %patient.gender = 'female'"
          }
        },
        {
          "id": "numerator",
          "code": {
            "coding": [
              {
                "system": "http://terminology.hl7.org/CodeSystem/measure-population",
                "code": "numerator"
              }
            ]
          },
          "description": "Her gestational age at the visit was under 12 weeks",
          "criteria": {
            "language": "text/fhirpath",
            "expression": "%records.entry.resource.ofType(Observation).where(encounter.reference = 'Encounter/' + %resource.id and code.coding.where(system = 'http://loinc.org' and code = '18185-9').exists()).value.value < 12"
          }
        }
      ]
    }
  ]
}
