{
  "resourceType": "Measure",
  "id": "anc-visits",
  "url": "https://health.go.ug/fhir/Measure/anc-visits",
  "version": "1.0.0",
  "name": "AncVisits",
  "title": "ANC visits",
  "status": "active",
  "description": "Every antenatal care visit by a woman in the period, first or follow-up (HMIS 105, ANC visits).",
  "extension": [
    {
      "url": "https://carapai.github.io/people-centered-healthcare/fhir/StructureDefinition/indicator-period-date",
      "valueExpression": {
        "language": "text/fhirpath",
        "expression": "Encounter.actualPeriod.start",
        "description": "When the visit started"
      }
    },
    {
      "url": "https://carapai.github.io/people-centered-healthcare/fhir/StructureDefinition/indicator-counts",
      "valueCode": "visits"
    }
  ],
  "scoring": {
    "coding": [
      {
        "system": "http://terminology.hl7.org/CodeSystem/measure-scoring",
        "code": "cohort"
      }
    ]
  },
  "basis": "Encounter",
  "group": [
    {
      "population": [
        {
          "id": "initial-population",
          "code": {
            "coding": [
              {
                "system": "http://terminology.hl7.org/CodeSystem/measure-population",
                "code": "initial-population"
              }
            ]
          },
          "description": "An ANC visit by a woman",
          "criteria": {
            "language": "text/fhirpath",
            "expression": "Encounter.type.coding.where(system = 'https://health.go.ug/fhir/CodeSystem/anc-visit-type').exists() and %patient.gender = 'female'"
          }
        }
      ]
    }
  ]
}
