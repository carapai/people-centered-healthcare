{
  "$schema": "https://carapai.github.io/people-centered-healthcare/fhir/schema/report/1",
  "id": "anc-facility-monitoring",
  "title": "ANC facility monitoring",
  "periodType": "monthly",
  "levels": ["facility"],
  "sections": [
    {
      "kind": "table",
      "id": "gestational-age",
      "title": "Gestational age at the 1st visit",
      "disaggregations": [],
      "rows": [
        { "id": "median-ga", "indicator": "https://health.go.ug/fhir/Measure/anc-gestational-age-at-first-visit|1.0.0", "label": "Median gestational age at the 1st visit (weeks)" }
      ],
      "columnTotals": false,
      "rowTotals": false,
      "change": true,
      "sendToDhis2": false
    },
    {
      "kind": "lineList",
      "id": "clients",
      "title": "ANC clients this month",
      "rowPer": "enrollment",
      "program": "https://health.go.ug/fhir/PlanDefinition/anc",
      "enrollments": "active",
      "columns": [
        { "id": "name", "label": "Name", "attribute": "person.name" },
        { "id": "age", "label": "Age (years)", "attribute": "person.age" },
        { "id": "phone", "label": "Phone", "attribute": "person.phone" },
        { "id": "enrolled", "label": "Enrolled on", "attribute": "enrollment.start" },
        { "id": "last-visit", "label": "Last visit", "attribute": "enrollment.lastVisit" },
        { "id": "gestational-age", "label": "Gestational age (weeks)", "concept": { "system": "http://loinc.org", "code": "18185-9" }, "pick": "latest" }
      ]
    },
    {
      "kind": "lineList",
      "id": "first-visits",
      "title": "1st visits counted",
      "rowPer": "visit",
      "program": "https://health.go.ug/fhir/PlanDefinition/anc",
      "visitTypes": [{ "system": "https://health.go.ug/fhir/CodeSystem/anc-visit-type", "code": "first" }],
      "countedBy": "https://health.go.ug/fhir/Measure/anc-first-visits|1.0.0",
      "columns": [
        { "id": "name", "label": "Name", "attribute": "person.name" },
        { "id": "date", "label": "Visit date", "attribute": "visit.date" },
        { "id": "gestational-age", "label": "Gestational age (weeks)", "concept": { "system": "http://loinc.org", "code": "18185-9" } }
      ]
    }
  ]
}
