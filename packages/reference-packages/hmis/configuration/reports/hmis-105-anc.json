{
  "$schema": "https://carapai.github.io/people-centered-healthcare/fhir/schema/report/1",
  "id": "hmis-105-anc",
  "title": "HMIS 105 · 2 Antenatal care",
  "periodType": "monthly",
  "levels": ["facility", "district", "region", "national"],
  "sections": [
    {
      "kind": "table",
      "id": "attendance",
      "title": "2.1 ANC attendance",
