        { "ageBandSet": "https://health.go.ug/fhir/Library/age-bands-anc|1.0.0", "axis": "columns" }
      ],
      "rows": [
        { "id": "first-visits", "indicator": "https://health.go.ug/fhir/Measure/anc-first-visits|1.0.0", "label": "ANC 1st visit for women" },
        { "id": "visits", "indicator": "https://health.go.ug/fhir/Measure/anc-visits|1.0.0", "label": "ANC visits (all)" }
      ],
      "columnTotals": false,
      "rowTotals": true,
      "change": true,
      "sendToDhis2": true,
      "mappings": [
        { "row": "first-visits", "bands": { "https://health.go.ug/fhir/Library/age-bands-anc|1.0.0": "10-14" }, "dataSet": "Hmis105Smpl", "dataElement": "An01aSample", "categoryOptionCombo": "Age1014Smpl", "from": "2024-07-01" },
        { "row": "first-visits", "bands": { "https://health.go.ug/fhir/Library/age-bands-anc|1.0.0": "15-19" }, "dataSet": "Hmis105Smpl", "dataElement": "An01aSample", "categoryOptionCombo": "Age1519Smpl", "from": "2024-07-01" },
        { "row": "first-visits", "bands": { "https://health.go.ug/fhir/Library/age-bands-anc|1.0.0": "20-24" }, "dataSet": "Hmis105Smpl", "dataElement": "An01aSample", "categoryOptionCombo": "Age2024Smpl", "from": "2024-07-01" },
        { "row": "first-visits", "bands": { "https://health.go.ug/fhir/Library/age-bands-anc|1.0.0": "25+" }, "dataSet": "Hmis105Smpl", "dataElement": "An01aSample", "categoryOptionCombo": "Age25upSmpl", "from": "2024-07-01" },
        { "row": "visits", "bands": { "https://health.go.ug/fhir/Library/age-bands-anc|1.0.0": "10-14" }, "dataSet": "Hmis105Smpl", "dataElement": "An02xSample", "categoryOptionCombo": "Age1014Smpl", "from": "2024-07-01" },
        { "row": "visits", "bands": { "https://health.go.ug/fhir/Library/age-bands-anc|1.0.0": "15-19" }, "dataSet": "Hmis105Smpl", "dataElement": "An02xSample", "categoryOptionCombo": "Age1519Smpl", "from": "2024-07-01" },
        { "row": "visits", "bands": { "https://health.go.ug/fhir/Library/age-bands-anc|1.0.0": "20-24" }, "dataSet": "Hmis105Smpl", "dataElement": "An02xSample", "categoryOptionCombo": "Age2024Smpl", "from": "2024-07-01" },
        { "row": "visits", "bands": { "https://health.go.ug/fhir/Library/age-bands-anc|1.0.0": "25+" }, "dataSet": "Hmis105Smpl", "dataElement": "An02xSample", "categoryOptionCombo": "Age25upSmpl", "from": "2024-07-01" }
      ]
    },
    {
      "kind": "table",
      "id": "timing",
      "title": "2.2 Timing of the 1st visit",
      "disaggregations": [],
      "rows": [
        { "id": "before-12-weeks", "indicator": "https://health.go.ug/fhir/Measure/anc-first-visit-before-12-weeks|1.0.0", "label": "ANC 1st visit before 12 weeks (%)" },
        { "id": "next-visit-booked", "indicator": "https://health.go.ug/fhir/Measure/anc-first-visit-next-visit-booked|1.0.0", "label": "ANC 1st visits with the next visit booked (%)" }
      ],
      "columnTotals": false,
