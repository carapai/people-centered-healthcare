{
  "openapi": "3.1.0",
  "info": {
    "title": "central-server",
    "version": "0.1.0"
  },
  "paths": {
    "/api/session": {
      "get": {
        "tags": [
          "identity"
        ],
        "summary": "Documents `GET /api/session`; the route itself is `health_auth::AuthServer::session_route`.",
        "description": "The signed-in session. Needs the access token (`Authorization: Bearer` or `DPoP`).",
        "operationId": "getSession",
        "responses": {
          "200": {
            "description": "The session is live",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SessionInfo"
                }
              }
            }
          },
          "401": {
            "description": "No valid access token, or the session has ended"
          }
        }
      }
    },
    "/health": {
      "get": {
        "tags": [
          "system"
        ],
        "summary": "Liveness: the process answers.",
        "operationId": "getHealth",
        "responses": {
          "200": {
            "description": "The process answers",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Health"
                }
              }
            }
          }
        }
      }
    },
    "/ready": {
      "get": {
        "tags": [
          "system"
        ],
        "summary": "Readiness: every readiness check passes.",
        "operationId": "getReady",
        "responses": {
          "200": {
            "description": "Every check passes",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ReadinessReport"
                }
              }
            }
          },
          "503": {
            "description": "A check fails",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ReadinessReport"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "CheckStatus": {
        "type": "string",
        "description": "One readiness check's result.",
        "enum": [
          "pass",
          "fail"
        ]
      },
      "Health": {
        "type": "object",
        "description": "Liveness: the process answers.",
        "required": [
          "status"
        ],
        "properties": {
          "status": {
            "$ref": "#/components/schemas/HealthStatus",
            "description": "Always `pass`."
          }
        }
      },
      "HealthStatus": {
        "type": "string",
        "description": "Always `pass` when the process answers at all.",
        "enum": [
          "pass"
        ]
      },
      "ReadinessReport": {
        "type": "object",
        "description": "Readiness: whether every dependency the node needs is usable.",
        "required": [
          "status",
          "checks"
        ],
        "properties": {
          "checks": {
            "type": "object",
            "description": "Each check's result, by its static name (e.g. `database`).",
            "additionalProperties": {
              "$ref": "#/components/schemas/CheckStatus"
            },
            "propertyNames": {
              "type": "string"
            }
          },
          "status": {
            "$ref": "#/components/schemas/ReadyStatus",
            "description": "`ready` when every check passes."
          }
        }
      },
      "ReadyStatus": {
        "type": "string",
        "description": "`ready` when every check passes.",
        "enum": [
          "ready",
          "not-ready"
        ]
      },
      "SessionInfo": {
        "type": "object",
        "description": "The signed-in session, as `GET /api/session` answers (served by `health-auth`).",
        "required": [
          "account",
          "client_id",
          "scope",
          "session"
        ],
        "properties": {
          "account": {
            "type": "string",
            "description": "The account id."
          },
          "client_id": {
            "type": "string",
            "description": "The client the session was issued to."
          },
          "facility": {
            "type": [
              "string",
              "null"
            ],
            "description": "The facility the session acts for (ADR 0056)."
          },
          "scope": {
            "type": "string",
            "description": "The scopes granted, space-separated."
          },
          "session": {
            "type": "string",
            "description": "The session id."
          }
        }
      }
    }
  }
}
