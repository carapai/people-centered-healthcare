#!/usr/bin/env bash
# A stand-in for `az keyvault key sign`, for the release dry run: signs the digest with the
# throwaway P-256 key in FAKE_KEY_VAULT_KEY (PEM) and answers as Key Vault does, with the raw
# r || s in base64url.
set -euo pipefail
[[ "$1 $2 $3" == "keyvault key sign" ]] || { echo "fake az: only keyvault key sign" >&2; exit 2; }
shift 3
while (($#)); do
  case $1 in
    --digest) digest=$2; shift 2 ;;
    --algorithm) [[ $2 == ES256 ]] || exit 2; shift 2 ;;
    --vault-name | --name | --query | --output) shift 2 ;;
    *) echo "fake az: unexpected $1" >&2; exit 2 ;;
  esac
done
printf '%s' "$digest" | openssl base64 -d -A >"${TMPDIR:-/tmp}/fake-az-digest"
openssl pkeyutl -sign -inkey "$FAKE_KEY_VAULT_KEY" -in "${TMPDIR:-/tmp}/fake-az-digest" |
  python3 -I -c '
import base64, sys
der = sys.stdin.buffer.read()
assert der[0] == 0x30
i = 2
out = b""
for _ in range(2):
    assert der[i] == 0x02
    n = der[i + 1]
    out += der[i + 2 : i + 2 + n].lstrip(b"\0").rjust(32, b"\0")
    i += 2 + n
print(base64.urlsafe_b64encode(out).decode().rstrip("="))
'
