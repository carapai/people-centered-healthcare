DEFINE TABLE auth_account TYPE NORMAL SCHEMAFULL PERMISSIONS NONE
  DEFINE FIELD credential ON auth_account TYPE string PERMISSIONS FULL
  DEFINE FIELD failures ON auth_account TYPE int PERMISSIONS FULL
  DEFINE FIELD locked_until ON auth_account TYPE none | datetime PERMISSIONS FULL
  DEFINE FIELD status ON auth_account TYPE string ASSERT $value INSIDE ['active', 'disabled'] PERMISSIONS FULL
  DEFINE FIELD username ON auth_account TYPE string PERMISSIONS FULL
  DEFINE INDEX auth_account_username ON auth_account FIELDS username UNIQUE
