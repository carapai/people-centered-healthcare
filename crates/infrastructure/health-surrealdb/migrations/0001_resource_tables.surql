-- Head and history tables for every owned FHIR resource type (persistence.md § Tables per
-- resource type; ADR 0051: `json` holds the stored bytes), plus the unit of work's guard,
-- counter and outbox tables. Generated with src/ownership/generated.rs; never edit after merge.

DEFINE TABLE account SCHEMAFULL;
DEFINE FIELD json ON account TYPE string;
DEFINE FIELD version_id ON account TYPE string;
DEFINE FIELD version_seq ON account TYPE int;
DEFINE FIELD last_updated ON account TYPE datetime;
DEFINE FIELD deleted ON account TYPE bool;
DEFINE TABLE account_history SCHEMAFULL;
DEFINE FIELD json ON account_history TYPE string;
DEFINE FIELD version_id ON account_history TYPE string;
DEFINE FIELD version_seq ON account_history TYPE int;
DEFINE FIELD last_updated ON account_history TYPE datetime;
DEFINE FIELD deleted ON account_history TYPE bool;
DEFINE INDEX account_history_last_updated ON account_history FIELDS last_updated, version_seq;

