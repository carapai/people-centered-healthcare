{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://carapai.github.io/people-centered-healthcare/fhir/schema/population/1",
  "title": "Population Estimates",
  "description": "A year's Population Estimates in a Population package (ADR 0071): the year, the estimate types (given per place, or derived as a percentage of another type) and each place's annual figure for the given types. What the schema cannot say (declared types, circles, repeated figures, place codes) Validation and the import check.",
  "type": "object",
  "required": ["$schema", "year", "types"],
  "additionalProperties": false,
  "properties": {
    "$schema": { "const": "https://carapai.github.io/people-centered-healthcare/fhir/schema/population/1" },
    "year": { "type": "integer", "minimum": 1900, "maximum": 9999 },
    "types": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/type" } },
    "figures": { "type": "array", "items": { "$ref": "#/$defs/figure" } }
  },
  "$defs": {
    "type": {
      "type": "object",
      "required": ["code"],
      "additionalProperties": false,
      "properties": {
        "code": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$" },
        "title": { "type": "string" },
        "derivedFrom": { "type": "string" },
        "percent": { "type": "string", "pattern": "^[0-9]+(\\.[0-9]+)?$" }
      },
      "dependentRequired": { "derivedFrom": ["percent"], "percent": ["derivedFrom"] }
    },
    "figure": {
      "type": "object",
      "required": ["place", "type", "value"],
      "additionalProperties": false,
      "properties": {
        "place": { "type": "string", "minLength": 1 },
        "type": { "type": "string" },
        "value": { "type": "integer", "minimum": 0 }
      }
    }
  }
}
