# The Facility Edge Node under systemd (facility-edge.md § OS service). Installed by the edge
# installer, which also writes /etc/health/facility-edge.env.
[Unit]
Description=Health Facility Edge Node
Wants=network-online.target
After=network-online.target
# The first start and three restarts within 24 h, then stay stopped and alert (the Windows
# SCM policy too).
StartLimitIntervalSec=86400
StartLimitBurst=4
# When the unit fails, the previous binary finishes any failed update's rollback, as root.
OnFailure=facility-edge-rollback.service

[Service]
Type=notify
NotifyAccess=main
# The full-disk encryption probe needs root (cryptsetup reads the LUKS2 header), so systemd
# runs it with full privileges ("+") before each start; the unprivileged service reads its
# file. A failed probe ("-") does not stop the node: an unreadable state is reported as unknown.
ExecStartPre=-+/opt/health/bin/facility-edge encryption probe --out /run/health/encryption.json
ExecStart=/opt/health/bin/facility-edge --service
EnvironmentFile=/etc/health/facility-edge.env
Environment=HEALTH_ENCRYPTION_STATE_FILE=/run/health/encryption.json
# The facility intermediate's key, sealed by `facility-edge provision request` with
# systemd-creds into /etc/credstore.encrypted/. systemd unseals it into $CREDENTIALS_DIRECTORY
# for the unprivileged service; before provisioning it is absent, which is not fatal.
LoadCredentialEncrypted=health.facility-intermediate.key
User=health
Group=health
StateDirectory=health
RuntimeDirectory=health
# HEALTH_DATA_DIR is under /var/lib/health, the only writable path.
# The edge keeps systemd informed: READY after migrations, WATCHDOG while alive, and
# EXTEND_TIMEOUT_USEC while a migration or drain runs.
TimeoutStartSec=120
TimeoutStopSec=120
WatchdogSec=30
Restart=on-failure
RestartSec=5
# Not restarted: a configuration error (2) or a refused update step (7) needs a person, and a
# half-finished rollback (8) fails the unit so the rollback unit restores the previous binary.
# A finished rollback (6) is restarted, which runs the previous binary.
RestartPreventExitStatus=2 7 8
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
