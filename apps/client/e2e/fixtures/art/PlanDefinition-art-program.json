  "action": [
    {
      "linkId": "baseline",
      "action": [
        {
          "title": "Baseline CD4 count",
          "definitionCanonical": "https://health.go.ug/fhir/ActivityDefinition/order-cd4|1.0.0"
        }
      ]
    },
    {
      "linkId": "initiation",
      "action": [
        {
          "title": "Regimen templates",
          "selectionBehavior": "at-most-one",
          "action": [
            {
              "title": "TDF/3TC/DTG, one tablet daily",
              "condition": [
                {
                  "kind": "applicability",
                  "expression": {
                    "language": "text/fhirpath",
                    "expression": "%patient.age() >= 10 and %patient.weight() >= 30"
                  }
                }
              ],
              "definitionCanonical": "https://health.go.ug/fhir/ActivityDefinition/rx-tld|1.0.0",
              "documentation": [
                {
                  "type": "citation",
                  "resource": "https://health.go.ug/protocols/consolidated-hiv-guidelines-2024",
                  "label": "4.3"
                }
              ]
            },
            {
              "title": "ABC/3TC with DTG, by weight band",
              "condition": [
                {
                  "kind": "applicability",
                  "expression": {
                    "language": "text/fhirpath",
                    "expression": "%patient.weight() >= 3 and %patient.weight() < 30"
                  }
                }
              ],
              "definitionCanonical": "https://health.go.ug/fhir/ActivityDefinition/rx-abc-3tc-dtg|1.0.0",
              "documentation": [
                {
                  "type": "citation",
                  "resource": "https://health.go.ug/protocols/consolidated-hiv-guidelines-2024",
                  "label": "4.4"
                }
              ]
            },
            {
              "title": "TLD with an extra DTG 50 mg twelve hours later",
              "condition": [
                {
                  "kind": "applicability",
                  "expression": {
                    "language": "text/fhirpath",
                    "expression": "%patient.age() >= 10 and %patient.weight() >= 30 and %patient.activeEpisode('tb').exists()"
                  }
                }
              ],
              "definitionCanonical": "https://health.go.ug/fhir/ActivityDefinition/rx-tld-extra-dtg|1.0.0",
              "documentation": [
                {
                  "type": "citation",
                  "resource": "https://health.go.ug/protocols/consolidated-hiv-guidelines-2024",
                  "label": "6.2"
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "linkId": "follow-up",
      "action": [
        {
          "title": "HIV viral load",
          "definitionCanonical": "https://health.go.ug/fhir/ActivityDefinition/order-hiv-vl|1.0.0"
        }
      ]
    }
  ]
