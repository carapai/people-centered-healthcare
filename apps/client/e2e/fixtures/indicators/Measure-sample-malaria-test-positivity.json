{
  "resourceType": "Measure",
  "id": "sample-malaria-test-positivity",
  "url": "https://health.go.ug/fhir/Measure/sample-malaria-test-positivity",
  "version": "1.0.0",
  "name": "SampleMalariaTestPositivity",
  "title": "Malaria test positivity (sample)",
  "status": "active",
  "description": "A sample for the data explorer's threshold colours on a local backend (#600): of the malaria tests (RDT or microscopy) done in the period, the percentage positive. Under 20% is good, 20% to under 40% a warning, and 40% and above bad.",
  "extension": [
    {
      "url": "https://carapai.github.io/people-centered-healthcare/fhir/StructureDefinition/indicator-period-date",
      "valueExpression": {
        "language": "text/fhirpath",
        "expression": "Observation.effective",
        "description": "When the test was done"
      }
    },
    {
      "url": "https://carapai.github.io/people-centered-healthcare/fhir/StructureDefinition/indicator-counts",
      "valueCode": "observations"
    },
    {
      "url": "https://carapai.github.io/people-centered-healthcare/fhir/StructureDefinition/indicator-threshold",
      "extension": [
        {
          "url": "to",
          "valueDecimal": 20
        },
        {
          "url": "tone",
          "valueCode": "good"
        }
      ]
    },
    {
      "url": "https://carapai.github.io/people-centered-healthcare/fhir/StructureDefinition/indicator-threshold",
      "extension": [
        {
          "url": "from",
          "valueDecimal": 20
        },
        {
          "url": "to",
          "valueDecimal": 40
        },
        {
          "url": "tone",
          "valueCode": "warning"
        }
      ]
    },
    {
      "url": "https://carapai.github.io/people-centered-healthcare/fhir/StructureDefinition/indicator-threshold",
      "extension": [
        {
          "url": "from",
          "valueDecimal": 40
        },
        {
          "url": "tone",
          "valueCode": "bad"
        }
      ]
    }
  ],
  "scoring": {
    "coding": [
      {
        "system": "http://terminology.hl7.org/CodeSystem/measure-scoring",
        "code": "proportion"
      }
    ]
  },
  "basis": "Observation",
  "group": [
    {
      "population": [
        {
          "id": "initial-population",
          "code": {
            "coding": [
              {
                "system": "http://terminology.hl7.org/CodeSystem/measure-population",
                "code": "initial-population"
              }
            ]
          },
          "description": "Every observation in the period",
          "criteria": {
            "language": "text/fhirpath",
            "expression": "true"
          }
        },
        {
          "id": "denominator",
          "code": {
            "coding": [
              {
                "system": "http://terminology.hl7.org/CodeSystem/measure-population",
                "code": "denominator"
              }
            ]
          },
          "description": "A malaria test",
          "criteria": {
            "language": "text/fhirpath",
            "expression": "Observation.code.coding.where(system = 'http://loinc.org' and (code = '70569-9' or code = '32700-7')).exists()"
          }
        },
        {
          "id": "numerator",
          "code": {
            "coding": [
              {
                "system": "http://terminology.hl7.org/CodeSystem/measure-population",
                "code": "numerator"
              }
            ]
          },
          "description": "Its result was positive",
          "criteria": {
            "language": "text/fhirpath",
            "expression": "Observation.interpretation.coding.where(system = 'http://terminology.hl7.org/CodeSystem/v3-ObservationInterpretation' and code = 'POS').exists()"
          }
        }
      ]
    }
  ]
}
