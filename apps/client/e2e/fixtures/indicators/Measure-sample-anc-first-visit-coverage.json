{
  "resourceType": "Measure",
  "id": "sample-anc-first-visit-coverage",
  "url": "https://health.go.ug/fhir/Measure/sample-anc-first-visit-coverage",
  "version": "1.0.0",
  "name": "SampleAncFirstVisitCoverage",
  "title": "ANC 1st visit coverage (sample)",
  "status": "active",
  "description": "A sample for coverage against Population Estimates on a local backend (#553): women whose first antenatal care visit was in the period, over the place's expected pregnancies for the period.",
  "extension": [
    {
      "url": "https://carapai.github.io/people-centered-healthcare/fhir/StructureDefinition/indicator-period-date",
      "valueExpression": {
        "language": "text/fhirpath",
        "expression": "Encounter.actualPeriod.start",
        "description": "When the visit started"
      }
    },
    {
      "url": "https://carapai.github.io/people-centered-healthcare/fhir/StructureDefinition/indicator-counts",
      "valueCode": "people"
    },
    {
      "url": "https://carapai.github.io/people-centered-healthcare/fhir/StructureDefinition/indicator-denominator-estimate",
      "valueCode": "expected-pregnancies"
    }
  ],
  "scoring": {
    "coding": [
      {
        "system": "http://terminology.hl7.org/CodeSystem/measure-scoring",
        "code": "proportion"
      }
    ]
  },
  "basis": "Encounter",
  "group": [
    {
      "population": [
        {
          "id": "initial-population",
          "code": {
            "coding": [
              {
                "system": "http://terminology.hl7.org/CodeSystem/measure-population",
                "code": "initial-population"
              }
            ]
          },
          "criteria": {
            "language": "text/fhirpath",
            "expression": "true"
          }
        },
        {
          "id": "numerator",
          "code": {
            "coding": [
              {
                "system": "http://terminology.hl7.org/CodeSystem/measure-population",
                "code": "numerator"
              }
            ]
          },
          "description": "A first ANC visit by a woman",
          "criteria": {
            "language": "text/fhirpath",
            "expression": "Encounter.type.coding.where(system = 'https://health.go.ug/fhir/CodeSystem/anc-visit-type' and code = 'first').exists() and %patient.gender = 'female'"
          }
        }
      ]
    }
  ]
}
